# Options for /etc/init.d/S99epaper.
#
# SCRIPT is the demo to run, from /usr/share/epaper.
#   epaper-show.py    nine animated scenes (default)
#   epaper-photo.py   the photo gallery
SCRIPT=epaper-show.py

# ARGS is passed to it. See its --help.
#   epaper-show.py    --mode partial|fast|full, --scene NAME, --frames N
#   epaper-photo.py   --all --loop --pause N, --dither, --gamma
ARGS="--mode partial"
