# Options for /etc/init.d/S99epaper.
#
# ARGS is passed to epaper-show.py. See its --help.
#   --mode partial   no flash between frames (default)
#   --mode fast      full refresh, fast waveform
#   --mode full      full refresh, normal waveform
#   --scene NAME     run one scene instead of cycling
#   --frames N       frames per scene
ARGS="--mode partial"
