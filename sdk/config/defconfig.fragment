# Appended to buildroot/configs/rockchip_rk3506_luckfox_defconfig by apply.sh.

# Use +=, not =. The Rockchip fragments build the overlay list with +=, and
# merge_config.sh lets a plain = replace the whole list.
BR2_ROOTFS_OVERLAY+="/sdk/lyra-overlay"

# The SDK default, mirrors.ustc.edu.cn, returns 403 outside China. With no
# backup site the build dies at host-make with a download error.
BR2_GNU_MIRROR="https://ftpmirror.gnu.org"

# zlib.net moves old releases to /fossils/ and 404s the versioned path.
BR2_BACKUP_SITE="https://sources.buildroot.net"
